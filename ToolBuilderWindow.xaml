<Window x:Class="FanucSimulator.ToolBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tool Builder" Height="560" Width="780"
        Background="#0a0a0a" Foreground="#f0f0f0"
        FontFamily="Courier New" ResizeMode="CanResize">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="TOOL BUILDER"
                   Foreground="{StaticResource ScreenHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <!-- Left: tool parameters, light LCD screen look matching the OFFSET screen -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource ScreenBg}"
                BorderBrush="{StaticResource ScreenBorder}" BorderThickness="1" Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel>
                    <TextBlock Text="InsertDesignation" Style="{StaticResource ScreenFieldLabel}"/>
                    <TextBox x:Name="InsertDesignationBox" Text="CUSTOM01" Margin="0,0,0,8" TextChanged="Field_Changed"/>

                    <TextBlock Text="HolderDesignation" Style="{StaticResource ScreenFieldLabel}"/>
                    <TextBox x:Name="HolderDesignationBox" Text="CUSTOM-HOLDER" Margin="0,0,0,8" TextChanged="Field_Changed"/>

                    <TextBlock Text="Description" Style="{StaticResource ScreenFieldLabel}"/>
                    <TextBox x:Name="DescriptionBox" Text="Custom tool" Margin="0,0,0,8" TextChanged="Field_Changed"/>

                    <TextBlock Text="Type" Style="{StaticResource ScreenFieldLabel}"/>
                    <ComboBox x:Name="TypeCombo" Margin="0,0,0,8" SelectionChanged="TypeCombo_SelectionChanged"/>

                    <TextBlock Text="Insert" Style="{StaticResource ScreenFieldLabel}"/>
                    <ComboBox x:Name="InsertCombo" Margin="0,0,0,8" SelectionChanged="Field_Changed"/>

                    <TextBlock Text="Nose Radius (mm)" Style="{StaticResource ScreenFieldLabel}"/>
                    <TextBox x:Name="NoseRadiusBox" Text="0.4" Margin="0,0,0,8" TextChanged="Field_Changed"/>

                    <TextBlock Text="Width (mm) - groove/blade thickness or drill diameter" Style="{StaticResource ScreenFieldLabel}" TextWrapping="Wrap"/>
                    <TextBox x:Name="WidthBox" Text="0" Margin="0,0,0,8" TextChanged="Field_Changed"/>

                    <TextBlock Text="Groove Reference (grooving / threading only)" Style="{StaticResource ScreenFieldLabel}" TextWrapping="Wrap"/>
                    <ComboBox x:Name="GrooveReferenceCombo" Margin="0,0,0,8" SelectionChanged="Field_Changed"/>

                    <TextBlock Text="Insert Reach (mm) - max groove depth / thread engagement (grooving / threading only)" Style="{StaticResource ScreenFieldLabel}" TextWrapping="Wrap"/>
                    <TextBox x:Name="InsertReachBox" Text="6" Margin="0,0,0,8" TextChanged="Field_Changed"/>

                    <TextBlock Text="Shank Size (mm)" Style="{StaticResource ScreenFieldLabel}"/>
                    <TextBox x:Name="ShankSizeBox" Text="25" Margin="0,0,0,8" TextChanged="Field_Changed"/>

                    <TextBlock Text="Overhang (mm)" Style="{StaticResource ScreenFieldLabel}"/>
                    <TextBox x:Name="OverhangBox" Text="40" Margin="0,0,0,8" TextChanged="Field_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right: live preview -->
        <Border Grid.Row="1" Grid.Column="1" Background="#0a0a0a" BorderBrush="#333" BorderThickness="2">
            <Canvas x:Name="PreviewCanvas" Background="#0a0a0a" SizeChanged="PreviewCanvas_SizeChanged"/>
        </Border>

        <!-- Bottom action bar -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Apply to Tool #:" VerticalAlignment="Center" Foreground="#6a8a9a" Margin="0,0,6,0"/>
            <ComboBox x:Name="ApplyToolNumberCombo" Width="50" VerticalAlignment="Center"/>
            <CheckBox x:Name="AddToSessionCatalogCheck" Content="Also add to tool catalog (saved)"
                      Foreground="#6a8a9a" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Content="Apply" Click="Apply_Click" Style="{StaticResource PanelButton}" Margin="16,0,0,0"/>
            <Button Content="Close" Click="Close_Click" Style="{StaticResource PanelButton}"/>
        </StackPanel>
    </Grid>
</Window>
