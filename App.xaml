<Application x:Class="FanucSimulator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Shared across MainWindow and any secondary window (e.g. ToolBuilderWindow) - the CRT
             screen theme + panel-button chrome. Everything else stays local to MainWindow.xaml's
             own Window.Resources since only MainWindow uses it.
             Retheme note: this was a light grey-olive LCD palette until photos of the user's actual
             0i-TF Plus showed the real thing is the classic FANUC blue CRT - near-white text on a
             medium steel blue, with lighter blue rules boxing each section off. Every screen (POS/
             PROGRAM/OFFSET/ALARM/MACRO/HELP + Tool Builder) recolors from these seven brushes. -->
        <SolidColorBrush x:Key="ScreenBg" Color="#4e7191"/>
        <SolidColorBrush x:Key="ScreenAltRow" Color="#456986"/>
        <SolidColorBrush x:Key="ScreenBorder" Color="#93b8d4"/>
        <SolidColorBrush x:Key="ScreenHeader" Color="#a8e8ff"/>
        <SolidColorBrush x:Key="ScreenValue" Color="#ffffff"/>
        <SolidColorBrush x:Key="ScreenStatLabel" Color="#dceaf5"/>
        <SolidColorBrush x:Key="ScreenMuted" Color="#b4d0e4"/>

        <!-- Soft keys sit below the CRT and read as light physical keys against it, not as more
             screen - light blue-grey face, dark navy legend, matching the reference photos. -->
        <SolidColorBrush x:Key="SoftKeyBg" Color="#b9cddd"/>
        <SolidColorBrush x:Key="SoftKeyText" Color="#123049"/>
        <SolidColorBrush x:Key="SoftKeyDisabledText" Color="#7e93a5"/>

        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="Foreground" Value="#00ff00"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>
        <Style x:Key="DisabledPanelButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
        <Style x:Key="ScreenFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource ScreenMuted}"/>
        </Style>

        <!-- Blue scrollbars, matching the CRT palette above - stock grey Windows chrome on OFFSET/
             MACRO (and now the window's own outer scroll region) broke the CRT illusion the rest of
             the screen commits to. TargetType-only (no x:Key) so this reaches every ScrollViewer
             and every DataGrid's built-in one app-wide, with no per-control changes needed.

             A full ControlTemplate, not just Setters, for the same reason the panel buttons needed
             one: the default ScrollBar chrome (arrows, 3D-look track) ignores plain Background/
             Foreground Setters. Both RepeatButtons are present (so page-up/page-down and the arrow
             hit-targets still work) but drawn invisible - a flat thumb-only bar reads as CRT
             furniture; two grey 3D arrow buttons would not. -->
        <Style x:Key="FanucScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource ScreenBorder}" CornerRadius="3" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#2a3f50"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="MinHeight" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FanucScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
