<Window x:Class="FanucSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leadwell LTC-208 - FANUC 0i-TF Plus" Height="1000" Width="1560"
        Background="#0a0a0a" Foreground="#f0f0f0"
        FontFamily="Courier New" Closing="Window_Closing">

    <Window.Resources>
        <!-- Dark panel chrome (title strip, mode buttons, action bar, console, MDI keypad) -->
        <SolidColorBrush x:Key="CyanText" Color="#29d6d6"/>
        <SolidColorBrush x:Key="ValueText" Color="#f0f0f0"/>
        <SolidColorBrush x:Key="MutedText" Color="#6a8a9a"/>
        <SolidColorBrush x:Key="AlarmRed" Color="#ff3b3b"/>
        <SolidColorBrush x:Key="OkGreen" Color="#29d629"/>

        <!-- Blue CRT screen theme - the screen area only, matching the reference photos of the
             user's real 0i-TF Plus. ScreenBg/ScreenAltRow/ScreenBorder/ScreenHeader/ScreenValue/
             ScreenStatLabel/ScreenMuted/SoftKey* and PanelButton/DisabledPanelButton/
             ScreenFieldLabel live in App.xaml so a secondary window (ToolBuilderWindow) shares them.
             On the real control the axis letters and the modal G-code block are plain white like
             everything else on the CRT - no separate accent colours. -->
        <SolidColorBrush x:Key="ScreenAxisLabel" Color="#ffffff"/>
        <SolidColorBrush x:Key="ScreenCode" Color="#ffffff"/>

        <Style x:Key="SoftKeyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SoftKeyBg}"/>
            <Setter Property="Foreground" Value="{StaticResource SoftKeyText}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="BorderBrush" Value="#7f96a8"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ActiveSoftKeyButton" TargetType="Button" BasedOn="{StaticResource SoftKeyButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource SoftKeyText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource SoftKeyText}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style x:Key="DisabledSoftKeyButton" TargetType="Button" BasedOn="{StaticResource SoftKeyButton}">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource SoftKeyDisabledText}"/>
        </Style>
        <Style x:Key="KeypadKey" TargetType="Button">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="{StaticResource ValueText}"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Height" Value="36"/>
            <!-- The default Button chrome paints its own "disabled" look (a pale system grey) that
                 ignores the Background setter above - exactly the same trap PanelToggleKey hit.
                 Most of this panel's keys are IsEnabled="False" by design (they have no engine
                 behaviour to back them), so left alone every one of them would render as a wrong,
                 washed-out white block instead of a dim, dark, clearly-inert key. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#8fa8bb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FunctionKey" TargetType="Button" BasedOn="{StaticResource KeypadKey}">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Panel keys that latch. The real panel's function keys have an integral lamp that lights
             while the switch is on, which is the only way the operator can tell - so the lit state
             is the whole point of this style, not decoration. -->
        <Style x:Key="PanelToggleKey" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="{StaticResource ValueText}"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <!-- The stock ToggleButton template paints its own "checked" look (the pale Windows
                 blue) and ignores Background, so the lamp has to be drawn here or the panel key
                 stops looking like a panel key the moment it latches. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="KeyFace" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="KeyFace" Property="Background" Value="#c8a000"/>
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#ffe680"/>
                                <Setter Property="Foreground" Value="#1a1a1a"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyFace" Property="BorderBrush" Value="#8fa8bb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>
        <!-- Tight vertical margin on purpose: the block is 8 rows deep and the real control packs
             them just as closely. With the default 4px all round the last two rows fell off the
             bottom of the screen area entirely. -->
        <Style x:Key="ModalCode" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource ScreenCode}"/>
            <Setter Property="Margin" Value="3,1"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ScreenBg}"/>
            <Setter Property="Foreground" Value="{StaticResource ScreenStatLabel}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>

    <!-- The operator panel below is sized to its real content, which is substantially taller
         than the placeholder key grid this used to be - real machines devote roughly as much
         panel height as screen height to it. Rather than let a short window silently squeeze or
         clip either area, everything scrolls: on a monitor tall enough for both, no scrollbar
         appears and this looks identical to a fixed layout. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*"/>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- MinHeight keeps the lathe canvas and screen usable even though a ScrollViewer
                 offers this row infinite height, which would otherwise collapse "*" to zero. -->
            <RowDefinition Height="*" MinHeight="620"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Left: Lathe view -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1a1a1a" BorderThickness="2" BorderBrush="#333">
                <Grid>
                    <Canvas x:Name="LatheCanvas" Background="#0a0a0a" SizeChanged="LatheCanvas_SizeChanged"
                            MouseWheel="LatheCanvas_MouseWheel"
                            MouseLeftButtonDown="LatheCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="LatheCanvas_MouseLeftButtonUp"
                            MouseMove="LatheCanvas_MouseMove"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" IsHitTestVisible="True">
                        <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"/>
                        <Button Content="Reset View" Click="ResetCanvasView_Click" Style="{StaticResource PanelButton}" Padding="6,2" FontSize="11"/>
                        <Button Content="3D View..." Click="Open3DView_Click" Style="{StaticResource PanelButton}" Padding="6,2" FontSize="11" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#1a1a1a" Margin="0,4,0,0">
                <TextBlock x:Name="StockDiameterLabel" Text="Stock Diameter (in):" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="6,4,4,4"/>
                <TextBox x:Name="StockDiameterInput" Width="62" Background="#0a0a0a" Foreground="{StaticResource ValueText}" Text="3.0000"/>
                <TextBlock x:Name="StockLengthLabel" Text="Length (in):" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="12,0,4,0"/>
                <TextBox x:Name="StockLengthInput" Width="62" Background="#0a0a0a" Foreground="{StaticResource ValueText}" Text="4.0000"/>
                <Button Content="Apply" Click="ApplyStock_Click" Style="{StaticResource PanelButton}" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Middle: Control panel -->
        <Grid Grid.Row="0" Grid.Column="1" Background="#1a1a1a" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- Title strip -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#e8c000" Padding="8,3">
                    <TextBlock Text="FANUC" Foreground="#a00000" FontWeight="Bold" FontSize="16"/>
                </Border>
                <TextBlock Grid.Column="1" Text="Series 0i-TF" Foreground="{StaticResource ValueText}" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Border Grid.Column="2" Background="#1a8f9e" Padding="8,3">
                    <TextBlock Text="Plus" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>
            </Grid>

            <!-- The real screen carries no on-screen mode row at all - EDIT/AUTO/MDI/TEACH/JOG/
                 MPG/INC JOG/ZRN is a physical MODE cluster on the operator panel below (see the
                 "Bottom: Operator panel" section), which is where ModeEditButton/ModeAutoButton/
                 ModeMdiButton now live. Row 1 stays reserved (Auto height, no content) so the row
                 indices below don't need renumbering. -->

            <!-- Screen -->
            <Border Grid.Row="2" Background="{StaticResource ScreenBg}" BorderThickness="2" BorderBrush="{StaticResource ScreenBorder}" Margin="0,0,0,8">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="380"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Swappable screen content -->
                    <Grid Grid.Row="0">

                        <!-- POS screen -->
                        <StackPanel x:Name="PosScreen">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="PosHeaderDisplay" Text="POSITION(ABS)" Foreground="{StaticResource ScreenHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="ProgramIdDisplay" Text="O0000 N00000" Foreground="{StaticResource ScreenValue}" FontSize="19" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- ABS sub-view: simple large X/Z, matching the close reference photo -->
                            <StackPanel x:Name="PosAbsView" Margin="0,4,0,10">
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="X" FontSize="26" FontWeight="Bold" Foreground="{StaticResource ScreenAxisLabel}"/>
                                    <TextBlock Grid.Column="1" x:Name="AbsXBigDisplay" Text="0.000" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ScreenValue}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Z" FontSize="26" FontWeight="Bold" Foreground="{StaticResource ScreenAxisLabel}"/>
                                    <TextBlock Grid.Column="1" x:Name="AbsZBigDisplay" Text="0.000" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ScreenValue}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- RELATIVE sub-view: the operator's own scratch counter, zeroable per
                                 axis, which is what makes it different from ABSOLUTE. -->
                            <StackPanel x:Name="PosRelView" Visibility="Collapsed" Margin="0,4,0,10">
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="U" FontSize="26" FontWeight="Bold" Foreground="{StaticResource ScreenAxisLabel}"/>
                                    <TextBlock Grid.Column="1" x:Name="RelUBigDisplay" Text="0.0000" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ScreenValue}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="W" FontSize="26" FontWeight="Bold" Foreground="{StaticResource ScreenAxisLabel}"/>
                                    <TextBlock Grid.Column="1" x:Name="RelWBigDisplay" Text="0.0000" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ScreenValue}" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="ORIGIN:" Foreground="{StaticResource ScreenStatLabel}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="U ZERO" Click="ZeroRelU_Click" Style="{StaticResource SoftKeyButton}" Width="80"/>
                                    <Button Content="W ZERO" Click="ZeroRelW_Click" Style="{StaticResource SoftKeyButton}" Width="80"/>
                                    <Button Content="ALL ZERO" Click="ZeroRelAll_Click" Style="{StaticResource SoftKeyButton}" Width="86"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ALL sub-view: laid out to match the real 0i-TF Plus POS(ALL) screen -
                                 a 2x2 block of ruled position boxes (RELATIVE/ABSOLUTE over MACHINE/
                                 DISTANCE TO GO) with the modal G-code block ruled off beneath them,
                                 and a right-hand column carrying the big feed readout, the machine
                                 counters, and a live preview of the loaded program. -->
                            <StackPanel x:Name="PosAllView" Visibility="Collapsed" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: position boxes + modal block -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <UniformGrid Rows="2" Columns="2">
                                            <Border BorderBrush="{StaticResource ScreenBorder}" BorderThickness="1" Padding="6,4" Margin="0,0,-1,-1">
                                                <StackPanel>
                                                    <TextBlock Text="RELATIVE" Foreground="{StaticResource ScreenStatLabel}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="RelUDisplay" Text="U      0.000" FontSize="15" Foreground="{StaticResource ScreenValue}" Margin="0,3,0,0"/>
                                                    <TextBlock x:Name="RelWDisplay" Text="W      0.000" FontSize="15" Foreground="{StaticResource ScreenValue}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="{StaticResource ScreenBorder}" BorderThickness="1" Padding="6,4" Margin="0,0,0,-1">
                                                <StackPanel>
                                                    <TextBlock Text="ABSOLUTE" Foreground="{StaticResource ScreenStatLabel}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="AbsXDisplay" Text="X      0.000" FontSize="15" Foreground="{StaticResource ScreenValue}" Margin="0,3,0,0"/>
                                                    <TextBlock x:Name="AbsZDisplay" Text="Z      0.000" FontSize="15" Foreground="{StaticResource ScreenValue}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="{StaticResource ScreenBorder}" BorderThickness="1" Padding="6,4" Margin="0,0,-1,0">
                                                <StackPanel>
                                                    <TextBlock Text="MACHINE" Foreground="{StaticResource ScreenStatLabel}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="MachXDisplay" Text="X      0.000" FontSize="15" Foreground="{StaticResource ScreenValue}" Margin="0,3,0,0"/>
                                                    <TextBlock x:Name="MachZDisplay" Text="Z      0.000" FontSize="15" Foreground="{StaticResource ScreenValue}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderBrush="{StaticResource ScreenBorder}" BorderThickness="1" Padding="6,4">
                                                <StackPanel>
                                                    <TextBlock Text="DISTANCE TO GO" Foreground="{StaticResource ScreenStatLabel}" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="DistXDisplay" Text="X      0.000" FontSize="15" Foreground="{StaticResource ScreenValue}" Margin="0,3,0,0"/>
                                                    <TextBlock x:Name="DistZDisplay" Text="Z      0.000" FontSize="15" Foreground="{StaticResource ScreenValue}"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border BorderBrush="{StaticResource ScreenBorder}" BorderThickness="1" Padding="6,5" Margin="0,-1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Three code columns plus the address-letter column,
                                                     reproducing the real screen's modal block layout. -->
                                                <UniformGrid Grid.Column="0" Rows="8" Columns="4">
                                                    <TextBlock x:Name="ModalMotionDisplay" Text="G00" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalCycleDisplay" Text="G80" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalPolarInterpDisplay" Text="G13.1" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalAddrFDisplay" Text="F" Style="{StaticResource ModalCode}"/>

                                                    <TextBlock x:Name="ModalSpindleDisplay" Text="G97" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalMacroDisplay" Text="G67" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalMirrorDisplay" Text="G50.1" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalAddrHDisplay" Text="H" Style="{StaticResource ModalCode}"/>

                                                    <TextBlock x:Name="ModalCoordRotDisplay" Text="G69" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalWorkOffsetDisplay" Text="G54" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalToolLengthDisplay" Text="G49" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalAddrDDisplay" Text="D" Style="{StaticResource ModalCode}"/>

                                                    <TextBlock x:Name="ModalFeedDisplay" Text="G99" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalCuttingModeDisplay" Text="G64" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalPolarCmdDisplay" Text="G15" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalToolDisplay" Text="T00" Style="{StaticResource ModalCode}"/>

                                                    <TextBlock x:Name="ModalUnitsDisplay" Text="G20" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalPlaneDisplay" Text="G18" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalHighSpeedDisplay" Text="G05.5" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalAddrSDisplay" Text="S" Style="{StaticResource ModalCode}"/>

                                                    <TextBlock x:Name="ModalCompDisplay" Text="G40" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalBalancedDisplay" Text="G69.1" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock Text="" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock Text="" Style="{StaticResource ModalCode}"/>

                                                    <TextBlock x:Name="ModalSpeedFluctDisplay" Text="G25" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalNormalDirDisplay" Text="G40.1" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalEgbBDisplay" Text="G80.5" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalAddrBDisplay" Text="B" Style="{StaticResource ModalCode}"/>

                                                    <TextBlock x:Name="ModalStrokeCheckDisplay" Text="G22" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalPolygonDisplay" Text="G50.2" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock x:Name="ModalEgbADisplay" Text="G80.4" Style="{StaticResource ModalCode}"/>
                                                    <TextBlock Text="" Style="{StaticResource ModalCode}"/>
                                                </UniformGrid>
                                                <!-- The M field lists the auxiliary codes actually in
                                                     effect. Spindle direction and coolant are the two
                                                     continuously-held M states this engine tracks, so
                                                     both are listed rather than only one. -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="6,1,0,0">
                                                    <TextBlock x:Name="ModalMCodeDisplay" Text="M   05" Style="{StaticResource ModalCode}" Margin="0,1"/>
                                                    <TextBlock x:Name="ModalCoolantDisplay" Text="M   09" Style="{StaticResource ModalCode}" Margin="0,1"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: feed readout, machine counters, program preview -->
                                    <StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="F" FontSize="20" Foreground="{StaticResource ScreenValue}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="AllFeedDisplay" Text="0.00 mm/rev" FontSize="20" FontWeight="Bold"
                                                       Foreground="{StaticResource ScreenValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="PARTS COUNT" FontSize="11" Foreground="{StaticResource ScreenStatLabel}"/>
                                            <TextBlock x:Name="AllPartCountDisplay" Text="0" FontSize="11" Foreground="{StaticResource ScreenValue}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="RUN TIME" FontSize="11" Foreground="{StaticResource ScreenStatLabel}"/>
                                            <TextBlock x:Name="AllRunTimeDisplay" Text="0H 0M 0S" FontSize="11" Foreground="{StaticResource ScreenValue}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="CYCLE TIME" FontSize="11" Foreground="{StaticResource ScreenStatLabel}"/>
                                            <TextBlock x:Name="AllCycleTimeDisplay" Text="0H 0M 0S" FontSize="11" Foreground="{StaticResource ScreenValue}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TextBlock Text="PROGRAM" FontSize="11" Foreground="{StaticResource ScreenStatLabel}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                        <Border BorderBrush="{StaticResource ScreenBorder}" BorderThickness="1" Height="128" Padding="5,4">
                                            <TextBlock x:Name="AllProgramPreview" FontSize="12" Foreground="{StaticResource ScreenValue}"
                                                       FontFamily="Courier New" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Spindle/limit strip along the screen's bottom edge, as on the real control -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="AllSpindleDisplay" Text="S        0" FontSize="12" Foreground="{StaticResource ScreenValue}"/>
                                    <TextBlock Grid.Column="1" Text="SLM     0" FontSize="12" Foreground="{StaticResource ScreenValue}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Machine stats, ABS sub-view only - the ALL sub-view above carries its
                                 own counters in the right-hand column, laid out as on the real control. -->
                            <Grid x:Name="PosAbsStats" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="RUN TIME" FontSize="11" Foreground="{StaticResource ScreenStatLabel}"/>
                                        <TextBlock Grid.Column="1" x:Name="RunTimeDisplay" Text="0H 0M 0S" FontSize="11" Foreground="{StaticResource ScreenValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PART COUNT" FontSize="11" Foreground="{StaticResource ScreenStatLabel}"/>
                                        <TextBlock Grid.Column="1" x:Name="PartCountDisplay" Text="0" FontSize="11" Foreground="{StaticResource ScreenValue}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CYCLE TIME" FontSize="11" Foreground="{StaticResource ScreenStatLabel}"/>
                                        <TextBlock Grid.Column="1" x:Name="CycleTimeDisplay" Text="0H 0M 0S" FontSize="11" Foreground="{StaticResource ScreenValue}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="S" Style="{StaticResource ScreenFieldLabel}"/>
                                    <TextBlock x:Name="SpindleDisplay" Text="STOPPED" FontSize="14" Foreground="{StaticResource ScreenValue}" Margin="0,0,0,4"/>
                                    <TextBlock Text="F" Style="{StaticResource ScreenFieldLabel}"/>
                                    <TextBlock x:Name="FeedDisplay" Text="0.00 mm/rev" FontSize="14" Foreground="{StaticResource ScreenValue}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Sub-view soft keys, spelled as the real screen spells them -->
                            <UniformGrid Rows="1">
                                <Button x:Name="PosAbsSubTab" Content="ABSOLUTE" Tag="ABS" Click="PosSubTab_Click" Style="{StaticResource ActiveSoftKeyButton}"/>
                                <Button x:Name="PosRelSubTab" Content="RELATIVE" Tag="REL" Click="PosSubTab_Click" Style="{StaticResource SoftKeyButton}"/>
                                <Button x:Name="PosAllSubTab" Content="ALL" Tag="ALL" Click="PosSubTab_Click" Style="{StaticResource SoftKeyButton}"/>
                                <Button Content="HANDLE" Style="{StaticResource DisabledSoftKeyButton}"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- PROGRAM screen -->
                        <Grid x:Name="ProgramScreen" Visibility="Collapsed">

                            <!-- Editor sub-view -->
                            <Grid x:Name="ProgramEditorView">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="ProgramEditorHeader" Text="PROGRAM (EDIT):" Foreground="{StaticResource ScreenHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Save" Click="Save_Click" Style="{StaticResource PanelButton}"/>
                                        <Button Content="Load..." Click="Load_Click" Style="{StaticResource PanelButton}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="GCodeInput" Grid.Row="1" Padding="5" Background="{StaticResource ScreenAltRow}" Foreground="{StaticResource ScreenValue}"
                                        BorderBrush="{StaticResource ScreenBorder}" CaretBrush="White" SelectionBrush="#a8e8ff"
                                        TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                        AcceptsReturn="True" AcceptsTab="True" GotFocus="Input_GotFocus" TextChanged="GCodeInput_TextChanged"
                                        Text="G21&#xD;&#xA;G54&#xD;&#xA;T0101 M6&#xD;&#xA;G97 S1200 M3&#xD;&#xA;G0 X50 Z100&#xD;&#xA;G99 G1 Z50 F0.2&#xD;&#xA;G4 P300&#xD;&#xA;M8&#xD;&#xA;G0 Z100&#xD;&#xA;M9&#xD;&#xA;G28&#xD;&#xA;M5&#xD;&#xA;M30"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Recent:" Foreground="{StaticResource ScreenMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel x:Name="RecentFilesPanel" Orientation="Horizontal"/>
                                </StackPanel>
                            </Grid>

                            <!-- Folder list sub-view: PROG hard key -> FOLDER soft key -->
                            <Grid x:Name="ProgramFolderView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="PROGRAM FOLDER" Foreground="{StaticResource ScreenHeader}" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ListBox x:Name="ProgramFolderList" Grid.Row="1" Background="{StaticResource ScreenBg}"
                                         Foreground="{StaticResource ScreenValue}" BorderBrush="{StaticResource ScreenBorder}"
                                         FontFamily="Courier New"/>
                            </Grid>

                            <!-- BG-EDIT split-screen sub-view: FOLDER -> select program -> BG-EDIT -> select 2nd program.
                                 Click into either box to make it "active" (mirrors SHIFT+Left/Right on a real control);
                                 COPY reads the active box's text selection, PASTE inserts it into whichever box is active
                                 when pressed - so the real flow is: select text, COPY, click the other box, PASTE. -->
                            <Grid x:Name="ProgramBgEditView" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" x:Name="BgEditLeftHeader" Foreground="{StaticResource ScreenHeader}" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="BgEditLeftBox" Grid.Row="1" Padding="5" Background="{StaticResource ScreenAltRow}" Foreground="{StaticResource ScreenValue}"
                                             CaretBrush="White" SelectionBrush="#a8e8ff"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AcceptsTab="True"
                                             FontFamily="Courier New" BorderBrush="{StaticResource ScreenHeader}" BorderThickness="2"
                                             GotFocus="BgEditLeftBox_GotFocus" TextChanged="BgEditLeftBox_TextChanged"/>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" x:Name="BgEditRightHeader" Foreground="{StaticResource ScreenHeader}" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="BgEditRightBox" Grid.Row="1" Padding="5" Background="{StaticResource ScreenAltRow}" Foreground="{StaticResource ScreenValue}"
                                             CaretBrush="White" SelectionBrush="#a8e8ff"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AcceptsTab="True"
                                             FontFamily="Courier New" BorderBrush="{StaticResource ScreenBorder}" BorderThickness="1"
                                             GotFocus="BgEditRightBox_GotFocus" TextChanged="BgEditRightBox_TextChanged"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- OFFSET screen -->
                        <Grid x:Name="OffsetScreen" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="TOOL OFFSETS" Style="{StaticResource ScreenFieldLabel}" Margin="0,0,0,4"/>
                                    <DataGrid x:Name="ToolOffsetGrid" Height="170" AutoGenerateColumns="False"
                                              Background="{StaticResource ScreenBg}" Foreground="{StaticResource ScreenValue}" RowBackground="{StaticResource ScreenBg}"
                                              AlternatingRowBackground="{StaticResource ScreenAltRow}" BorderBrush="{StaticResource ScreenBorder}" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource ScreenBorder}" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"
                                              RowEditEnding="OffsetGrid_RowEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tool#" Binding="{Binding Number}" IsReadOnly="True" Width="40"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
                                            <DataGridTextColumn Header="Insert" Binding="{Binding Insert}" Width="65"/>
                                            <DataGridTextColumn Header="X Geom" Binding="{Binding XGeometry}" Width="55"/>
                                            <DataGridTextColumn Header="Z Geom" Binding="{Binding ZGeometry}" Width="55"/>
                                            <DataGridTextColumn Header="X Wear" Binding="{Binding XWear}" Width="50"/>
                                            <DataGridTextColumn Header="Z Wear" Binding="{Binding ZWear}" Width="50"/>
                                            <DataGridTextColumn Header="Nose R" Binding="{Binding NoseRadius}" Width="50"/>
                                            <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="45"/>
                                            <DataGridTextColumn Header="Shank" Binding="{Binding ShankSize}" Width="45"/>
                                            <DataGridTextColumn Header="Overhang" Binding="{Binding Overhang}" Width="60"/>
                                            <DataGridTextColumn Header="Catalog Source" Binding="{Binding CatalogDesignation}" IsReadOnly="True" Width="160"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="WORK OFFSETS" Style="{StaticResource ScreenFieldLabel}" Margin="0,8,0,4"/>
                                    <DataGrid x:Name="WorkOffsetGrid" Height="120" AutoGenerateColumns="False"
                                              Background="{StaticResource ScreenBg}" Foreground="{StaticResource ScreenValue}" RowBackground="{StaticResource ScreenBg}"
                                              AlternatingRowBackground="{StaticResource ScreenAltRow}" BorderBrush="{StaticResource ScreenBorder}" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource ScreenBorder}" CanUserAddRows="False"
                                              RowEditEnding="OffsetGrid_RowEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="G-Code" Binding="{Binding GCode}" IsReadOnly="True" Width="55"/>
                                            <DataGridTextColumn Header="X" Binding="{Binding X}" Width="70"/>
                                            <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="TOOL CATALOG" Style="{StaticResource ScreenFieldLabel}" Margin="0,8,0,4"/>
                                    <ListBox x:Name="ToolCatalogList" Height="150" Background="{StaticResource ScreenBg}"
                                             Foreground="{StaticResource ScreenValue}" BorderBrush="{StaticResource ScreenBorder}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                        <TextBlock Text="Assign to Tool #:" VerticalAlignment="Center" Foreground="{StaticResource ScreenMuted}" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="AssignToolNumberCombo" Width="50"/>
                                        <Button Content="Assign" Click="AssignCatalogEntry_Click" Style="{StaticResource PanelButton}" Margin="8,0,0,0"/>
                                        <Button Content="Tool Builder..." Click="OpenToolBuilder_Click" Style="{StaticResource PanelButton}" Margin="16,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ALARM screen -->
                        <Grid x:Name="AlarmScreen" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ACTIVE ALARMS" Style="{StaticResource ScreenFieldLabel}" Margin="0,0,0,4"/>
                            <DataGrid x:Name="AlarmList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="{StaticResource ScreenBg}" Foreground="{StaticResource AlarmRed}" RowBackground="{StaticResource ScreenBg}"
                                      AlternatingRowBackground="{StaticResource ScreenAltRow}" BorderBrush="{StaticResource ScreenBorder}" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource ScreenBorder}" CanUserAddRows="False" FontWeight="Bold">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="50"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- MACRO screen: Custom Macro B variable viewer -->
                        <Grid x:Name="MacroScreen" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="LOCAL VARIABLES (#1-#33, current scope) - double-click Value to edit" Style="{StaticResource ScreenFieldLabel}" Margin="0,0,0,4"/>
                                    <DataGrid x:Name="MacroLocalGrid" Height="220" AutoGenerateColumns="False" IsReadOnly="False"
                                              Background="{StaticResource ScreenBg}" Foreground="{StaticResource ScreenValue}" RowBackground="{StaticResource ScreenBg}"
                                              AlternatingRowBackground="{StaticResource ScreenAltRow}" BorderBrush="{StaticResource ScreenBorder}" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource ScreenBorder}" CanUserAddRows="False" RowEditEnding="MacroGrid_RowEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Variable" Binding="{Binding Variable}" Width="80" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=TwoWay}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="COMMON VARIABLES (#100-#999, assigned only) - double-click Value to edit" Style="{StaticResource ScreenFieldLabel}" Margin="0,8,0,4"/>
                                    <DataGrid x:Name="MacroCommonGrid" Height="150" AutoGenerateColumns="False" IsReadOnly="False"
                                              Background="{StaticResource ScreenBg}" Foreground="{StaticResource ScreenValue}" RowBackground="{StaticResource ScreenBg}"
                                              AlternatingRowBackground="{StaticResource ScreenAltRow}" BorderBrush="{StaticResource ScreenBorder}" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource ScreenBorder}" CanUserAddRows="False" RowEditEnding="MacroGrid_RowEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Variable" Binding="{Binding Variable}" Width="80" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=TwoWay}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="(No common variables assigned yet)" x:Name="MacroCommonEmptyLabel" Foreground="{StaticResource ScreenMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- HELP screen -->
                        <Grid x:Name="HelpScreen" Visibility="Collapsed">
                            <ScrollViewer x:Name="HelpScrollViewer" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="HelpContent" Margin="0,0,8,0"/>
                            </ScrollViewer>
                        </Grid>

                    </Grid>

                    <!-- Persistent status bar -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="StatusModeDisplay" Text="EDIT" Foreground="{StaticResource ScreenHeader}" FontWeight="Bold" FontSize="12"/>
                        <Border Grid.Column="1" x:Name="StatusEmgBadge" Background="Transparent" Padding="5,1" Margin="8,0">
                            <TextBlock x:Name="StatusEmgText" Text="--EMG--" Foreground="{StaticResource ScreenHeader}" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <Border Grid.Column="2" x:Name="StatusAlarmBadge" Background="{StaticResource AlarmRed}" Padding="5,1" Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock Text="ALM" Foreground="White" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <TextBlock Grid.Column="3" x:Name="StatusClockDisplay" Text="00:00:00" Foreground="{StaticResource ScreenValue}" FontSize="12"/>
                    </Grid>

                    <!-- Persistent command line -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource ScreenBorder}" BorderThickness="1" Padding="4,3">
                            <DockPanel>
                                <TextBlock Text="A&gt;" Foreground="Black" FontWeight="Bold" DockPanel.Dock="Left" Margin="0,0,4,0"/>
                                <TextBox x:Name="CommandLineInput" Background="Transparent" Foreground="Black" BorderThickness="0"
                                        TextWrapping="NoWrap" VerticalContentAlignment="Center" GotFocus="Input_GotFocus"/>
                            </DockPanel>
                        </Border>
                        <Button Grid.Column="1" Content="Run" Click="RunMdi_Click" Style="{StaticResource PanelButton}" Margin="6,0,0,0"/>
                    </Grid>

                    <!-- Soft-key tab row -->
                    <UniformGrid Grid.Row="3" Rows="1" Margin="0,8,0,0">
                        <Button x:Name="PosTabButton" Content="POS" Tag="POS" Click="ScreenButton_Click" Style="{StaticResource SoftKeyButton}"/>
                        <Button x:Name="ProgramTabButton" Content="PROGRAM" Tag="PROGRAM" Click="ScreenButton_Click" Style="{StaticResource SoftKeyButton}"/>
                        <Button x:Name="OffsetTabButton" Content="OFFSET" Tag="OFFSET" Click="ScreenButton_Click" Style="{StaticResource SoftKeyButton}"/>
                        <Button x:Name="AlarmTabButton" Content="ALARM" Tag="ALARM" Click="ScreenButton_Click" Style="{StaticResource SoftKeyButton}"/>
                        <Button x:Name="MacroTabButton" Content="MACRO" Tag="MACRO" Click="ScreenButton_Click" Style="{StaticResource SoftKeyButton}"/>
                        <Button x:Name="HelpTabButton" Content="HELP" Tag="HELP" Click="ScreenButton_Click" Style="{StaticResource SoftKeyButton}"/>
                    </UniformGrid>

                    <!-- Hardware soft-key strip - data-driven from _softKeyStack (SoftKeyMenu). Real
                         program-management navigation (FOLDER/OPRT/DEVICE CHANGE) drives this on the
                         PROGRAM screen; other screens currently leave it all blank/disabled. -->
                    <UniformGrid Grid.Row="4" Rows="1" Margin="0,2,0,0">
                        <Button x:Name="SoftKey0" Tag="0" Click="SoftKeyButton_Click" Style="{StaticResource DisabledSoftKeyButton}"/>
                        <Button x:Name="SoftKey1" Tag="1" Click="SoftKeyButton_Click" Style="{StaticResource DisabledSoftKeyButton}"/>
                        <Button x:Name="SoftKey2" Tag="2" Click="SoftKeyButton_Click" Style="{StaticResource DisabledSoftKeyButton}"/>
                        <Button x:Name="SoftKey3" Tag="3" Click="SoftKeyButton_Click" Style="{StaticResource DisabledSoftKeyButton}"/>
                        <Button x:Name="SoftKey4" Tag="4" Click="SoftKeyButton_Click" Style="{StaticResource DisabledSoftKeyButton}"/>
                        <Button x:Name="SoftKey5" Tag="5" Click="SoftKeyButton_Click" Style="{StaticResource DisabledSoftKeyButton}"/>
                        <Button x:Name="SoftKey6" Tag="6" Click="SoftKeyButton_Click" Style="{StaticResource DisabledSoftKeyButton}"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Action bar -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Execute (Cycle Start)" Click="Execute_Click" Background="#004400" Foreground="#00ff00" Padding="10" Margin="0,0,8,0"/>
                <Button Content="Reset" Click="Reset_Click" Background="#1a1a1a" Foreground="#00ff00" Padding="10"/>
            </StackPanel>

            <!-- Console -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Console:" Margin="0,0,0,5"/>
                <TextBox x:Name="Console" Grid.Row="1" Padding="5" Background="#0a0a0a" Foreground="#00ff00"
                        IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>

        <!-- Right: MDI keypad -->
        <Grid Grid.Row="0" Grid.Column="2" Background="#1a1a1a" Margin="0,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="MDI KEYPAD" Style="{StaticResource FieldLabel}" Margin="4,4,0,6"/>

            <UniformGrid x:Name="DualKeyGrid" Grid.Row="1" Rows="4" Columns="6" Margin="0,0,0,8"/>

            <UniformGrid Grid.Row="2" Rows="2" Columns="6" Margin="0,0,0,8">
                <Button Content="POS" Tag="POS" Click="ScreenButton_Click" Style="{StaticResource FunctionKey}"/>
                <Button Content="PROG" Tag="PROGRAM" Click="ScreenButton_Click" Style="{StaticResource FunctionKey}"/>
                <Button Content="OFS/SET" Tag="OFFSET" Click="ScreenButton_Click" Style="{StaticResource FunctionKey}"/>
                <Button x:Name="ShiftKeyButton" Content="SHIFT" Click="ShiftKey_Click" Style="{StaticResource FunctionKey}"/>
                <Button Content="CAN" Click="CanKey_Click" Style="{StaticResource FunctionKey}"/>
                <Button Content="INPUT" Click="InputKey_Click" Style="{StaticResource FunctionKey}"/>
                <Button Content="SYSTEM" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                <Button Content="MESSAGE" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                <Button Content="CSTM/GR" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                <Button Content="ALTER" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                <Button Content="INSERT" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                <Button Content="DELETE" Click="DeleteKey_Click" Style="{StaticResource FunctionKey}"/>
            </UniformGrid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="PAGE&#10;UP" Click="PageUp_Click" Style="{StaticResource FunctionKey}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="&#8593;" Click="ArrowUp_Click" Style="{StaticResource FunctionKey}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="HELP" Tag="HELP" Click="ScreenButton_Click" Style="{StaticResource FunctionKey}"/>

                <Button Grid.Row="1" Grid.Column="0" Content="&#8592;" Click="ArrowLeft_Click" Style="{StaticResource FunctionKey}"/>
                <Button Grid.Row="1" Grid.Column="1" Content="&#9679;" IsEnabled="False" Style="{StaticResource FunctionKey}"/>
                <Button Grid.Row="1" Grid.Column="2" Content="&#8594;" Click="ArrowRight_Click" Style="{StaticResource FunctionKey}"/>

                <Button Grid.Row="2" Grid.Column="0" Content="PAGE&#10;DOWN" Click="PageDown_Click" Style="{StaticResource FunctionKey}"/>
                <Button Grid.Row="2" Grid.Column="1" Content="&#8595;" Click="ArrowDown_Click" Style="{StaticResource FunctionKey}"/>
                <Button Grid.Row="2" Grid.Column="2" Content="RESET" Click="Reset_Click" Style="{StaticResource FunctionKey}" Background="#440000"/>
            </Grid>
        </Grid>

        <!-- Bottom: Operator panel, laid out to match the reference photos' groups: FUNCTION,
             OPTION, JOG and SPINDLE key blocks stacked center, E-STOP/FEED/RAPID/CYCLE keys to
             their left, MODE/status LEDs/TURRET to their right.

             Only keys the engine can honestly back are wired: SBK/BDT/OSP (single block, block
             skip, optional stop - Phase D), EDIT/AUTO/MDI (mode), CYCLE START, RESET (up in the
             cursor-arrow cluster) and E-STOP. Everything else on this panel is real on the
             machine but has no counterpart in a 2-axis, non-real-time simulation - manual jogging,
             chuck/tailstock/conveyor state, spindle jog, dry run, machine lock - so those keys are
             visibly present, correctly grouped and labelled, and inert. Faking any of them would
             claim behaviour this simulator does not have. -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#4a4a52" Margin="10,8,10,10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: E-stop, override dials, cycle keys -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Grid Width="76" Height="76" HorizontalAlignment="Center">
                        <Ellipse Width="76" Height="76" Fill="#e8c000"/>
                        <Ellipse x:Name="EStopEllipse" Width="56" Height="56" Fill="#c81414" Stroke="#600000" StrokeThickness="2"
                                 Cursor="Hand" MouseLeftButtonDown="EStop_Click"/>
                    </Grid>
                    <TextBlock Text="EMERGENCY STOP" Foreground="{StaticResource MutedText}" FontSize="8" HorizontalAlignment="Center" Margin="0,3,0,10" TextWrapping="Wrap" TextAlignment="Center" Width="76"/>

                    <TextBlock Text="FEED / %" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center"/>
                    <Grid Width="58" Height="58" Margin="0,2,0,10">
                        <Ellipse Fill="#1a1a1a" Stroke="#777" StrokeThickness="1.5"/>
                        <Line X1="29" Y1="29" X2="45" Y2="14" Stroke="White" StrokeThickness="2"/>
                    </Grid>

                    <TextBlock Text="RAPID / INC" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center"/>
                    <Grid Width="58" Height="58" Margin="0,2,0,12">
                        <Ellipse Fill="#1a1a1a" Stroke="#777" StrokeThickness="1.5"/>
                        <Line X1="29" Y1="29" X2="12" Y2="14" Stroke="White" StrokeThickness="2"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="&#9679;" Click="Execute_Click" Background="#004400" Foreground="#29d629"
                                Width="40" Height="40" FontSize="20" Margin="0,0,6,0" ToolTip="CYCLE START"/>
                        <!-- FEED HOLD stops motion mid-block on a real control. This engine executes a
                             block atomically (there is no mid-block pause point), so honouring the
                             press would either do nothing while claiming to, or silently act as RESET,
                             which FEED HOLD is not. Left inert rather than either. -->
                        <Button Content="&#9679;" IsEnabled="False" Background="#440000" Foreground="#803030"
                                Width="40" Height="40" FontSize="20" ToolTip="FEED HOLD (not modeled - blocks run atomically)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock Text="CYCLE START" Foreground="{StaticResource MutedText}" FontSize="7" Width="46" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="FEED HOLD" Foreground="{StaticResource MutedText}" FontSize="7" Width="46" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: FUNCTION / OPTION / JOG / SPINDLE, stacked exactly as the panel is -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="FUNCTION" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <UniformGrid Rows="2" Columns="4">
                        <ToggleButton x:Name="SingleBlockKey" Content="SBK" Checked="PanelSwitch_Changed" Unchecked="PanelSwitch_Changed" Style="{StaticResource PanelToggleKey}" ToolTip="SINGLE BLOCK"/>
                        <ToggleButton x:Name="BlockSkipKey" Content="BDT" Checked="PanelSwitch_Changed" Unchecked="PanelSwitch_Changed" Style="{StaticResource PanelToggleKey}" ToolTip="BLOCK SKIP"/>
                        <ToggleButton x:Name="OptStopKey" Content="OSP" Checked="PanelSwitch_Changed" Unchecked="PanelSwitch_Changed" Style="{StaticResource PanelToggleKey}" ToolTip="OPTIONAL STOP"/>
                        <Button Content="LAMP" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="DRN" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="DRY RUN"/>
                        <Button Content="M.S.T" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="M/S/T LOCK"/>
                        <Button Content="M.L.K" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="MACHINE LOCK"/>
                        <Button Content="BUZZER" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                    </UniformGrid>

                    <TextBlock Text="OPTION" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                    <UniformGrid Rows="3" Columns="4">
                        <Button Content="OUT" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="TAILSTOCK OUT"/>
                        <Button Content="IN" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="TAILSTOCK IN"/>
                        <Button Content="TAIL" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="M30&#10;APO" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="AUTO POWER OFF AFTER M30"/>
                        <Button Content="OPEN" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="CHUCK OPEN"/>
                        <Button Content="CLOSE" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="CHUCK CLOSE"/>
                        <Button Content="CW" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="CONVEYOR CW"/>
                        <Button Content="CCW" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="CONVEYOR CCW"/>
                        <Button Content="MAN" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="AUTO" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="CLEAN" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="WGUN" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="WASH GUN"/>
                    </UniformGrid>

                    <TextBlock Text="JOG" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                    <UniformGrid Rows="3" Columns="4">
                        <Button Content="SETTER" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="Y" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="Y axis - not modeled, see Scope"/>
                        <Button Content="ORI." Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="SPINDLE ORIENT"/>
                        <Button Content="SP#1-C" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="X" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="Z" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="C" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="C axis - not modeled, see Scope"/>
                        <Button Content="HOME" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="-" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="RAPID" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="+" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="O.T" Style="{StaticResource FunctionKey}" IsEnabled="False" Background="#440000" ToolTip="OVERTRAVEL RELEASE"/>
                    </UniformGrid>

                    <TextBlock Text="SPINDLE" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                    <UniformGrid Rows="2" Columns="4">
                        <Button Content="CW" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="STOP" Style="{StaticResource FunctionKey}" IsEnabled="False" Background="#440000"/>
                        <Button Content="CCW" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="JOG" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="DEC" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="100%" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="INC" Style="{StaticResource FunctionKey}" IsEnabled="False"/>
                        <Button Content="RESET" Style="{StaticResource FunctionKey}" IsEnabled="False" ToolTip="Spindle override reset - not the system RESET"/>
                    </UniformGrid>
                </StackPanel>

                <!-- Right: status LEDs, MODE, TURRET -->
                <StackPanel Grid.Column="2" Margin="16,0,16,0" Width="150">
                    <UniformGrid Rows="1" Columns="6" Margin="0,0,0,2">
                        <TextBlock Text="X" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="Z" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="C" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="Y" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="M02" Foreground="{StaticResource MutedText}" FontSize="7" HorizontalAlignment="Center"/>
                        <TextBlock Text="SP#1" Foreground="{StaticResource MutedText}" FontSize="7" HorizontalAlignment="Center"/>
                    </UniformGrid>
                    <UniformGrid Rows="1" Columns="6" Margin="0,0,0,10">
                        <Ellipse Width="9" Height="9" Fill="#555" HorizontalAlignment="Center"/>
                        <Ellipse Width="9" Height="9" Fill="#555" HorizontalAlignment="Center"/>
                        <Ellipse Width="9" Height="9" Fill="#555" HorizontalAlignment="Center"/>
                        <Ellipse Width="9" Height="9" Fill="#555" HorizontalAlignment="Center"/>
                        <!-- Lights whenever a run most recently ended via M02/M30 - a passive readout of
                             real state (RunResult.ProgramEnded), cleared the moment Execute runs again. -->
                        <Ellipse x:Name="ProgramEndLed" Width="9" Height="9" Fill="#555" HorizontalAlignment="Center"/>
                        <!-- Lights whenever the spindle is actually turning (SpindleDir != 0) - likewise
                             a passive readout, not a control. -->
                        <Ellipse x:Name="SpindleActiveLed" Width="9" Height="9" Fill="#555" HorizontalAlignment="Center"/>
                    </UniformGrid>

                    <TextBlock Text="MODE" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button x:Name="ModeEditButton" Content="EDIT" Tag="EDIT" Click="ModeButton_Click" Style="{StaticResource PanelButton}" Padding="6,2" FontSize="10"/>
                        <Button x:Name="ModeAutoButton" Content="AUTO" Tag="AUTO" Click="ModeButton_Click" Style="{StaticResource PanelButton}" Padding="6,2" FontSize="10"/>
                        <Button x:Name="ModeMdiButton" Content="MDI" Tag="MDI" Click="ModeButton_Click" Style="{StaticResource PanelButton}" Padding="6,2" FontSize="10"/>
                    </StackPanel>

                    <!-- The rotary half of MODE: TEACH/MPG/JOG/INC JOG/ZRN. None have engine behaviour
                         (no manual jogging or handle-wheel model exists), so the dial is a faithful
                         static face, not a control - turning a physical knob isn't something a mouse
                         click can honestly stand in for anyway. -->
                    <Canvas Width="110" Height="90" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Ellipse Canvas.Left="27" Canvas.Top="12" Width="56" Height="56" Fill="#1a1a1a" Stroke="#777" StrokeThickness="1.5"/>
                        <Line X1="55" Y1="40" X2="70" Y2="26" Stroke="#999" StrokeThickness="2" Canvas.Left="0" Canvas.Top="0"/>
                        <TextBlock Text="TEACH" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="2" Canvas.Top="8"/>
                        <TextBlock Text="MPG" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="80" Canvas.Top="8"/>
                        <TextBlock Text="JOG" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="88" Canvas.Top="38"/>
                        <TextBlock Text="INC JOG" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="72" Canvas.Top="66"/>
                        <TextBlock Text="ZRN" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="4" Canvas.Top="66"/>
                    </Canvas>

                    <TextBlock Text="TURRET" Foreground="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <Canvas Width="90" Height="90" HorizontalAlignment="Center">
                        <Ellipse Canvas.Left="15" Canvas.Top="15" Width="60" Height="60" Fill="#1a1a1a" Stroke="#777" StrokeThickness="1.5"/>
                        <!-- Twelve stations, matching this machine's actual turret (MachineSpec.
                             TurretStations) - the dial graphic here is drawn for 12 whether or not
                             that ever changes, rather than hardcoding the number twice. -->
                        <TextBlock Text="1" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="42" Canvas.Top="2"/>
                        <TextBlock Text="2" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="58" Canvas.Top="6"/>
                        <TextBlock Text="3" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="70" Canvas.Top="18"/>
                        <TextBlock Text="4" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="76" Canvas.Top="34"/>
                        <TextBlock Text="5" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="76" Canvas.Top="50"/>
                        <TextBlock Text="6" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="70" Canvas.Top="66"/>
                        <TextBlock Text="7" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="58" Canvas.Top="78"/>
                        <TextBlock Text="8" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="42" Canvas.Top="82"/>
                        <TextBlock Text="9" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="26" Canvas.Top="78"/>
                        <TextBlock Text="10" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="10" Canvas.Top="66"/>
                        <TextBlock Text="11" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="6" Canvas.Top="50"/>
                        <TextBlock Text="12" Foreground="{StaticResource MutedText}" FontSize="7" Canvas.Left="6" Canvas.Top="34"/>
                        <!-- Passive readout of the currently selected station, rotated in code
                             behind whenever CurrentTool changes - not a control. -->
                        <Line x:Name="TurretPointer" X1="45" Y1="45" X2="45" Y2="22" Stroke="#29d629" StrokeThickness="2.5"
                              Canvas.Left="0" Canvas.Top="0" RenderTransformOrigin="0.5,0.5">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="TurretPointerRotation" CenterX="45" CenterY="45" Angle="0"/>
                            </Line.RenderTransform>
                        </Line>
                    </Canvas>
                </StackPanel>

                <!-- Far right: key switches (decorative - a real key switch isn't something a mouse
                     click can honestly stand in for either) and the power/logo stack -->
                <StackPanel Grid.Column="3" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Ellipse Width="20" Height="20" Fill="#1a1a1a" Stroke="#999" StrokeThickness="1.5" HorizontalAlignment="Center"/>
                        <TextBlock Text="HANDLE&#10;KEY" Foreground="{StaticResource MutedText}" FontSize="7" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Ellipse Width="20" Height="20" Fill="#1a1a1a" Stroke="#999" StrokeThickness="1.5" HorizontalAlignment="Center"/>
                        <TextBlock Text="EDIT&#10;KEY" Foreground="{StaticResource MutedText}" FontSize="7" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <Ellipse Width="20" Height="20" Fill="#1a1a1a" Stroke="#999" StrokeThickness="1.5" HorizontalAlignment="Center"/>
                        <TextBlock Text="SP#1" Foreground="{StaticResource MutedText}" FontSize="7" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Border x:Name="PowerToggleButton" Width="30" Height="30" Background="#2a2a2a" BorderBrush="#666" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="PowerToggle_Click" Margin="0,0,0,10">
                            <TextBlock Text="&#9211;" Foreground="{StaticResource OkGreen}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="FANUC" Foreground="#c81414" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
